# Kopiere diese Datei zu ".env.local" und trage echte Werte ein,
# damit das Kontaktformular E-Mails verschickt.
# Ohne diese Werte landet eine Anfrage nur im Server-Log (siehe app/api/kontakt/route.ts).

# API-Schlüssel von https://resend.com
RESEND_API_KEY=

# An diese Adresse gehen die Formular-Anfragen
KONTAKT_EMPFAENGER=

# Absenderadresse – muss zu einer bei Resend verifizierten Domain gehören
KONTAKT_ABSENDER=
